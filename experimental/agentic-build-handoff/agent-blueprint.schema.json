{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brewser123/business-before-agents/experimental/agentic-build-handoff/agent-blueprint.schema.json",
  "title": "Experimental Business Before Agents Blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "initiative",
    "decision",
    "pilot_stage",
    "owner",
    "operating_model",
    "release_gates",
    "evaluation_criteria",
    "baseline_gap_gate",
    "authority_by_stage",
    "roles",
    "outcome",
    "scope",
    "workflow",
    "authority",
    "data",
    "controls",
    "tests",
    "open_questions"
  ],
  "properties": {
    "schema_version": { "const": "0.3-experimental" },
    "initiative": { "type": "string", "minLength": 1 },
    "decision": {
      "enum": [
        "bounded_agentic_pilot",
        "simpler_assistance_or_automation",
        "defer_pending_evidence_or_controls",
        "do_not_build"
      ]
    },
    "pilot_stage": {
      "enum": [
        "offline_evaluation",
        "isolated_sandbox",
        "not_applicable"
      ]
    },
    "owner": { "type": "string", "minLength": 1 },
    "operating_model": {
      "enum": [
        "human_team_with_ai_assistance",
        "hybrid_human_agent_team",
        "agent_supported_operating_workflow"
      ]
    },
    "release_gates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "allOf": [
        {
          "contains": { "type": "object", "properties": { "stage": { "const": "design_review" } }, "required": ["stage"] },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": { "type": "object", "properties": { "stage": { "const": "deterministic_baseline" } }, "required": ["stage"] },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": { "type": "object", "properties": { "stage": { "const": "agentic_challenger" } }, "required": ["stage"] },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": { "type": "object", "properties": { "stage": { "const": "production_consideration" } }, "required": ["stage"] },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "status", "authorization_level", "approver", "evidence_required", "authorized_scope", "invalidation_conditions"],
        "properties": {
          "stage": {
            "enum": ["design_review", "deterministic_baseline", "agentic_challenger", "production_consideration"]
          },
          "status": { "enum": ["pending", "approved", "rejected", "expired"] },
          "authorization_level": { "enum": ["design_only", "implementation_only", "offline_execution", "production_operation"] },
          "approver": { "type": "string", "minLength": 1 },
          "evidence_required": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "authorized_scope": { "type": "array", "items": { "type": "string" } },
          "invalidation_conditions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "approval_reference": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "approved" } }, "required": ["status"] },
            "then": { "properties": { "approval_reference": { "type": "string", "minLength": 1 } }, "required": ["approval_reference"] }
          }
        ]
      }
    },
    "evaluation_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "measure", "criterion_type", "operator", "value", "unit", "measurement_method", "status", "owner"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "measure": { "type": "string", "minLength": 1 },
          "criterion_type": { "enum": ["minimum_success", "maximum_failure", "resource_limit", "mandatory_condition"] },
          "operator": { "enum": ["gte", "lte", "eq", "required"] },
          "value": { "type": ["number", "string", "boolean", "null"] },
          "unit": { "type": "string" },
          "measurement_method": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pending", "approved"] },
          "owner": { "type": "string", "minLength": 1 },
          "approval_reference": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "approved" } }, "required": ["status"] },
            "then": {
              "properties": {
                "value": { "not": { "type": "null" } },
                "approval_reference": { "type": "string", "minLength": 1 }
              },
              "required": ["value", "approval_reference"]
            }
          }
        ]
      }
    },
    "baseline_gap_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "business_need", "baseline_method", "baseline_result", "required_threshold", "measured_gap", "business_consequence", "simpler_options_considered", "why_simpler_insufficient", "owner_decision", "approver"],
      "properties": {
        "status": { "enum": ["not_evaluated", "no_material_gap", "material_gap_pending", "material_gap_approved", "material_gap_rejected"] },
        "business_need": { "type": "string" },
        "baseline_method": { "type": "string" },
        "baseline_result": { "type": "string" },
        "required_threshold": { "type": "string" },
        "measured_gap": { "type": "string" },
        "business_consequence": { "type": "string" },
        "simpler_options_considered": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "why_simpler_insufficient": { "type": "string" },
        "owner_decision": { "enum": ["pending", "stop", "revise_baseline", "authorize_challenger"] },
        "approver": { "type": "string", "minLength": 1 },
        "decision_reference": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "owner_decision": { "const": "authorize_challenger" } }, "required": ["owner_decision"] },
          "then": {
            "properties": {
              "status": { "const": "material_gap_approved" },
              "decision_reference": { "type": "string", "minLength": 1 }
            },
            "required": ["status", "decision_reference"]
          }
        },
        {
          "if": { "properties": { "status": { "const": "material_gap_approved" } }, "required": ["status"] },
          "then": { "properties": { "owner_decision": { "const": "authorize_challenger" } }, "required": ["owner_decision"] }
        }
      ]
    },
    "authority_by_stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation", "proposed_operations", "production"],
      "properties": {
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "human_review_model", "substitution_rule", "authority_reference"],
          "properties": {
            "status": { "enum": ["pending", "approved", "rejected", "expired"] },
            "human_review_model": { "type": "string", "minLength": 1 },
            "substitution_rule": { "type": "string", "minLength": 1 },
            "authority_reference": { "type": "string", "minLength": 1 }
          }
        },
        "proposed_operations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "human_review_model", "substitution_rule", "authority_reference"],
          "properties": {
            "status": { "enum": ["not_designed", "proposed", "rejected"] },
            "human_review_model": { "type": "string", "minLength": 1 },
            "substitution_rule": { "type": "string", "minLength": 1 },
            "authority_reference": { "type": "string", "minLength": 1 }
          }
        },
        "production": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "approval_reference"],
          "properties": {
            "status": { "enum": ["not_reviewed", "pending", "approved", "rejected", "expired"] },
            "approval_reference": { "type": "string" }
          }
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "purpose", "accountable_human", "responsibilities", "handoffs", "fallback"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["human", "agent"] },
          "purpose": { "type": "string", "minLength": 1 },
          "accountable_human": { "type": "string", "minLength": 1 },
          "responsibilities": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "recommendations": { "type": "array", "items": { "type": "string" } },
          "permitted_actions": { "type": "array", "items": { "type": "string" } },
          "prohibited_actions": { "type": "array", "items": { "type": "string" } },
          "handoffs": { "type": "array", "items": { "type": "string" } },
          "fallback": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "outcome": {
      "type": "object",
      "required": ["problem", "target", "success_measures", "failure_signals"],
      "properties": {
        "problem": { "type": "string" },
        "target": { "type": "string" },
        "success_measures": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "failure_signals": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["included", "excluded"],
      "properties": {
        "included": { "type": "array", "items": { "type": "string" } },
        "excluded": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": ["pattern", "trigger", "steps", "completion_condition", "stop_conditions"],
      "properties": {
        "pattern": { "enum": ["assistant", "fixed_automation", "single_bounded_agent", "coordinated_agents", "other"] },
        "trigger": { "type": "string" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "objective", "approval_required", "on_failure"],
            "properties": {
              "id": { "type": "string" },
              "objective": { "type": "string" },
              "approval_required": { "type": "boolean" },
              "on_failure": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "completion_condition": { "type": "string" },
        "stop_conditions": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["capability", "level"],
        "properties": {
          "capability": { "type": "string" },
          "level": { "enum": ["prohibited", "prepare_only", "specific_approval", "bounded_execution"] },
          "approver_or_boundary": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "owner", "classification", "authoritative"],
        "properties": {
          "source": { "type": "string" },
          "owner": { "type": "string" },
          "classification": { "type": "string" },
          "authoritative": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "allowed_operations", "prohibited_operations"],
        "properties": {
          "name": { "type": "string" },
          "allowed_operations": { "type": "array", "items": { "type": "string" } },
          "prohibited_operations": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "controls": {
      "type": "object",
      "required": ["human_fallback", "logging", "shutdown", "rollback"],
      "properties": {
        "human_fallback": { "type": "string" },
        "logging": { "type": "string" },
        "shutdown": { "type": "string" },
        "rollback": { "type": "string" }
      },
      "additionalProperties": false
    },
    "tests": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "open_questions": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": {
        "properties": { "decision": { "const": "bounded_agentic_pilot" } },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "pilot_stage": { "enum": ["offline_evaluation", "isolated_sandbox"] }
        }
      },
      "else": {
        "properties": {
          "pilot_stage": { "const": "not_applicable" }
        }
      }
    }
  ]
}
